<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>CustomLootPool</AssemblyName>
    <RootNamespace>CustomLootPool</RootNamespace>
    <Version>1.2.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="config.json" />
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
