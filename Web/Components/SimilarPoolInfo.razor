@namespace CustomLootPool.Web.Components

<div class="clp-similar">
    @if (Pool is null)
    {
        <span class="clp-similar-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" /> @T("Lendo os lootpools...", "Reading loot pools...")</span>
    }
    else
    {
        <div class="clp-similar-row">
            <span class="clp-similar-label">@T("Lootpool", "Loot pool")</span>
            <span class="clp-similar-cat">@Pool.CategoryName</span>
        </div>

        @if (Pool.Items.Count > 0)
        {
            <div class="clp-similar-row clp-similar-items">
                <span class="clp-similar-label">@T("Já spawnam ali", "Already spawning there")</span>
                <div class="clp-similar-icons">
                    @foreach (var p in itemsExpanded ? Pool.Items : Pool.Items.Take(CollapsedItems))
                    {
                        <MudTooltip>
                            <TooltipContent>
                                <div class="clp-item-tip">
                                    <strong>@p.Item.Name</strong>
                                    <span>@ItemChance(p)</span>
                                </div>
                            </TooltipContent>
                            <ChildContent>
                                <img src="@p.Item.IconUrl" alt="@p.Item.Name" loading="lazy" onerror="this.style.visibility='hidden'" />
                            </ChildContent>
                        </MudTooltip>
                    }
                    @if (Pool.Items.Count > CollapsedItems)
                    {
                        <button class="clp-similar-more" @onclick="() => itemsExpanded = !itemsExpanded">
                            @(itemsExpanded ? T("menos", "less") : $"+{Pool.Items.Count - CollapsedItems}")
                        </button>
                    }
                </div>
                <span class="clp-help">@T("Passe o mouse num item para ver a chance dele.", "Hover an item to see its chance.")</span>
            </div>
        }

        @if (Loose)
        {
            <div class="clp-similar-row">
                <span class="clp-similar-label">@T("Pontos de spawn", "Spawn spots")</span>
                @if (Pool.Spots == 0)
                {
                    <span class="clp-warn">@T("Nenhum ponto de loot solto com itens dessa categoria nos mapas escolhidos.", "No loose loot spots with items of this category on the selected maps.")</span>
                }
                else
                {
                    <span>@Pool.Spots.ToString("N0")</span>
                }
            </div>
        }
        else
        {
            <div class="clp-similar-row clp-similar-containers">
                <span class="clp-similar-label">@T($"Contêineres ({Pool.Containers.Count})", $"Containers ({Pool.Containers.Count})")</span>
                @if (Pool.Containers.Count == 0)
                {
                    <span class="clp-warn">@T("Nenhum contêiner compatível nos mapas escolhidos.", "No matching containers on the selected maps.")</span>
                }
                else
                {
                    <div class="clp-similar-chips">
                        @foreach (var name in expanded ? Pool.Containers : Pool.Containers.Take(CollapsedCount))
                        {
                            <span class="clp-similar-chip" title="@name">@name</span>
                        }
                        @if (Pool.Containers.Count > CollapsedCount)
                        {
                            <button class="clp-similar-toggle" @onclick="() => expanded = !expanded">
                                @(expanded ? T("menos", "less") : T($"+{Pool.Containers.Count - CollapsedCount} mais", $"+{Pool.Containers.Count - CollapsedCount} more"))
                            </button>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public SimilarPool? Pool { get; set; }
    [Parameter] public bool Loose { get; set; }
    [Parameter] public bool Pt { get; set; }

    private const int CollapsedCount = 6;
    private const int CollapsedItems = 10;
    private bool expanded;
    private bool itemsExpanded;

    private string ItemChance(PoolItem p)
    {
        string pct = p.AveragePercent < 1 ? p.AveragePercent.ToString("0.##") : p.AveragePercent.ToString("0.#");
        return Loose
            ? T($"~{pct}% quando o ponto spawna, em {p.Places} pontos de loot", $"~{pct}% when the spot spawns, in {p.Places} loot spots")
            : T($"~{pct}% por sorteio, em {p.Places} tipos de contêiner", $"~{pct}% per roll, in {p.Places} container types");
    }

    private string T(string pt, string en) => Pt ? pt : en;
}
