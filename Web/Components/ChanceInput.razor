@namespace CustomLootPool.Web.Components

<div class="clp-chance @(Disabled ? "clp-chance-off" : "")">
    <div class="clp-chance-row">
        <MudSlider T="double" Value="@SliderValue" ValueChanged="@OnSlider" Min="0" Max="100" Step="1" Color="Color.Warning" Disabled="@Disabled" Class="clp-slider" />
        <MudNumericField T="double" Value="@Value" ValueChanged="@Set" Min="0" Max="90" Step="0.1" Format="0.###"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="%"
                         Disabled="@Disabled" Class="clp-chance-num" HideSpinButtons="true" />
    </div>
    <span class="clp-help">@Help</span>
    @if (!string.IsNullOrEmpty(Note))
    {
        <span class="clp-note">@Note</span>
    }
</div>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Help { get; set; }
    [Parameter] public string? Note { get; set; }

    // Logarithmic-ish slider: most useful chances are small, so the first half covers 0-5%
    private static readonly double[] Stops = [0, 0.1, 0.25, 0.5, 1, 2, 3, 5, 10, 20, 35, 50, 90];

    private double SliderValue
    {
        get
        {
            for (int i = 0; i < Stops.Length - 1; i++)
            {
                if (Value <= Stops[i + 1])
                {
                    double t = (Value - Stops[i]) / (Stops[i + 1] - Stops[i]);
                    return (i + t) * 100.0 / (Stops.Length - 1);
                }
            }
            return 100;
        }
    }

    private Task OnSlider(double pos)
    {
        double scaled = pos * (Stops.Length - 1) / 100.0;
        int i = Math.Min((int)scaled, Stops.Length - 2);
        double v = Stops[i] + (scaled - i) * (Stops[i + 1] - Stops[i]);
        v = v < 1 ? Math.Round(v, 2) : v < 10 ? Math.Round(v, 1) : Math.Round(v);
        return Set(v);
    }

    private Task Set(double v) => ValueChanged.InvokeAsync(Math.Clamp(v, 0, 90));
}
