@namespace CustomLootPool.Web.Components
@using SPTarkov.Server.Core.Models.Common
@inject LootInjectionService Injection

@if (Injection.GetPoolCategories() is not { } categories)
{
    <span class="clp-similar-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" /> @T("Lendo os lootpools...", "Reading loot pools...")</span>
}
else
{
    var options = categories
        .Where(c => !GenericNodes.Contains(c.Name))
        .OrderByDescending(c => c.ItemCount)
        .Select(c => new PickOption(c.Id, c.Name, ParentPath(c), c.ItemCount))
        .ToList();

    <ChipPicker Options="@options" Suggestions="@Suggestions(options)" Value="@Value" ValueChanged="@ValueChanged" Disabled="@Disabled" Pt="@Pt"
                Label="@T("Lootpools escolhidos", "Chosen loot pools")"
                Placeholder="@T("Buscar lootpool...", "Search loot pools...")"
                EmptyText="@T("Nenhum ainda. Busque abaixo ou use uma sugestão.", "None yet. Search below or use a suggestion.")"
                CountLabel="@T("itens", "items")"
                Help="@T("O item entra onde já spawnam itens desses lootpools.", "The item goes where items from these loot pools already spawn.")" />
}

@code {
    private static readonly HashSet<string> GenericNodes = new(StringComparer.OrdinalIgnoreCase) { "Compound item", "Stackable item", "Searchable item", "Item" };

    [Parameter] public List<string> Value { get; set; } = [];
    [Parameter] public EventCallback<List<string>> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Pt { get; set; }
    [Parameter] public string? ItemTpl { get; set; }

    private string T(string pt, string en) => Pt ? pt : en;

    private static string ParentPath(PoolCategory c)
    {
        var parts = c.Path.Split(" > ");
        return string.Join(" › ", parts.Take(parts.Length - 1).Where(p => !GenericNodes.Contains(p)));
    }

    private List<PickOption> Suggestions(List<PickOption> options)
    {
        if (string.IsNullOrEmpty(ItemTpl))
        {
            return [];
        }

        var ancestors = Injection.AncestorsOf(new MongoId(ItemTpl));
        return options.Where(o => ancestors.Contains(o.Id)).OrderBy(o => o.Count).Take(4).ToList();
    }
}
