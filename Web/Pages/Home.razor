@page "/customlootpool"
@attribute [Authorize(Policy = "Administrator")]
@layout BaseMudBlazorLayout
@implements IDisposable
@inject ConfigService ConfigService
@inject ItemCatalogService Catalog
@inject LootInjectionService Injection
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Custom Loot Pool</PageTitle>

<HeadContent>
    <link href="/CustomLootPool/css/customlootpool.css" rel="stylesheet" />
    <link href="/CustomLootPool/css/heatmap.css" rel="stylesheet" />
</HeadContent>

<div class="clp-page spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="clp-container pa-6">

        <MudPaper Elevation="0" Class="clp-hero spt-panel pa-5">
            <div class="clp-hero-copy">
                <MudText Typo="Typo.overline" Class="spt-kicker">Loot pool</MudText>
                <MudText Typo="Typo.h3" Class="spt-title">Custom Loot Pool</MudText>
                <MudText Typo="Typo.body2" Class="spt-subtitle mt-1">
                    @T("Escolha qualquer item do jogo e coloque ele para spawnar nos contêineres e no chão dos mapas. As mudanças valem a partir do próximo raid, sem reiniciar o servidor.",
                       "Pick any item in the game and make it spawn in containers and as loose loot on the maps. Changes apply from the next raid, no server restart needed.")
                </MudText>
            </div>
            <div class="clp-hero-actions">
                <div class="clp-lang" role="group" aria-label="Language">
                    <button class="@(IsPt ? "" : "clp-lang-on")" @onclick="@(() => SetLanguage("en"))" title="English">EN</button>
                    <button class="@(IsPt ? "clp-lang-on" : "")" @onclick="@(() => SetLanguage("pt"))" title="Português">PT</button>
                </div>
                <MudSwitch T="bool" Value="@working.Enabled" ValueChanged="@(v => { working.Enabled = v; })" Color="Color.Warning" Label="@(working.Enabled ? T("Mod ativo", "Mod enabled") : T("Mod desligado", "Mod disabled"))" />
                <div class="clp-save-row">
                    @if (IsDirty)
                    {
                        <span class="clp-dirty"><MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" /> @T("Alterações não salvas", "Unsaved changes")</span>
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Discard">@T("Descartar", "Discard")</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!IsDirty || externalChange)" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@T("Salvar", "Save")</MudButton>
                </div>
            </div>
        </MudPaper>

        @if (externalChange)
        {
            <MudAlert Severity="Severity.Warning">@T("Outra aba salvou alterações. Recarregue a configuração antes de salvar; suas alterações locais ainda não foram gravadas.", "Another editor saved changes. Reload the configuration before saving; your local edits have not been written.")
                <MudButton OnClick="Discard">@T("Recarregar configuração", "Reload configuration")</MudButton>
            </MudAlert>
        }
        @if (indexError is not null)
        {
            <MudAlert Severity="Severity.Warning">@T("Não foi possível carregar a prévia dos pools: ", "Could not load the pool preview: ") @indexError
                <MudButton OnClick="LoadPoolIndex">@T("Tentar novamente", "Retry")</MudButton>
            </MudAlert>
        }
        <p class="clp-help">@T("As chances são calculadas juntas em cada pool. Se a soma chegar a 100%, os itens configurados dividem todo o pool proporcionalmente. Entradas duplicadas usam a maior chance aplicável.", "Chances are calculated together in each pool. At a total of 100% or more, configured items share the entire pool proportionally. Duplicate entries use the highest applicable chance.")</p>

        @if (Injection.GetMultipliers() is { } multipliers && multipliers.Any(m => m.Changed))
        {
            <MudPaper Elevation="0" Class="clp-lol spt-panel pa-5">
                <div class="clp-lol-head">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="clp-accent-icon" />
                    <div class="clp-lol-copy">
                        <MudText Typo="Typo.h6">
                            @(LotsOfLoot ? T("Lots of Loot detectado", "Lots of Loot detected") : T("Multiplicadores de loot alterados", "Loot multipliers changed"))
                        </MudText>
                        <MudText Typo="Typo.body2" Class="spt-muted">
                            @T($"{ModLabel} não muda as suas chances. O que muda é quantos itens cada mapa sorteia, comparado ao jogo original: contêineres {MultRange(multipliers.Select(m => m.Static))}, loot no chão {MultRange(multipliers.Select(m => m.Loose))}. Como o seu item entra nesses sorteios, a quantidade dele muda junto.",
                               $"{ModLabel} doesn't change your chances. It changes how many items each map rolls compared to vanilla: containers {MultRange(multipliers.Select(m => m.Static))}, floor loot {MultRange(multipliers.Select(m => m.Loose))}. Since your item is part of those rolls, its amount changes too.")
                        </MudText>
                    </div>
                </div>

                <MudText Typo="Typo.subtitle2" Class="clp-lol-question">@T("Como os seus itens devem se comportar?", "How should your items behave?")</MudText>
                <div class="clp-lol-options" role="radiogroup">
                    <button role="radio" aria-checked="@(!working.CompensateLootMultipliers)" class="@($"clp-lol-option {(working.CompensateLootMultipliers ? "" : "clp-lol-option-on")}")"
                            @onclick="() => SetCompensate(false)">
                        <span class="clp-lol-radio"></span>
                        <span class="clp-lol-option-copy">
                            <strong>@T("Crescer junto com o Lots of Loot", "Grow with Lots of Loot")</strong>
                            <span>@T("O item fica mais comum, como todo o resto do loot. A % que você digita é usada do jeito que está.",
                                     "Your item becomes more common, like the rest of the loot. The % you type is used as is.")</span>
                        </span>
                    </button>
                    <button role="radio" aria-checked="@working.CompensateLootMultipliers" class="@($"clp-lol-option {(working.CompensateLootMultipliers ? "clp-lol-option-on" : "")}")"
                            @onclick="() => SetCompensate(true)">
                        <span class="clp-lol-radio"></span>
                        <span class="clp-lol-option-copy">
                            <strong>@T("Manter a quantidade do jogo original", "Keep the vanilla amount")</strong>
                            <span>@T("Você acha mais ou menos a mesma quantidade que acharia sem o Lots of Loot. O mod baixa a % em cada mapa para compensar os sorteios extras.",
                                     "You find about as many as you would without Lots of Loot. The mod lowers the % on each map to make up for the extra rolls.")</span>
                        </span>
                    </button>
                </div>

                <div class="clp-lol-footer">
                    <button class="clp-similar-toggle clp-lol-details" @onclick="() => showMultipliers = !showMultipliers">
                        @(showMultipliers ? T("Esconder multiplicadores por mapa", "Hide multipliers per map") : T("Ver multiplicadores por mapa", "Show multipliers per map"))
                    </button>
                    <span class="spt-muted">@T("Dica: use \"Simular raids\" para ver a quantidade real por raid.", "Tip: use \"Simulate raids\" to see the real amount per raid.")</span>
                </div>
                @if (showMultipliers)
                {
                    <div class="clp-lol-grid">
                        @foreach (var m in multipliers)
                        {
                            <div class="clp-lol-chip">
                                <strong>@m.MapName</strong>
                                <span>@T("contêineres", "containers") ×@m.Static.ToString("0.##") · @T("chão", "floor") ×@m.Loose.ToString("0.##")</span>
                            </div>
                        }
                    </div>
                }
            </MudPaper>
        }

        <div class="clp-add-row">
            <MudPaper Elevation="0" Class="clp-add spt-panel pa-5">
                <div class="clp-section-head">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircle" Class="clp-accent-icon" />
                    <div>
                        <MudText Typo="Typo.h6">@T("Adicionar item", "Add item")</MudText>
                        <MudText Typo="Typo.body2" Class="spt-muted">@T("Cole o ID do item (ex.: ", "Paste the item ID (e.g. ")<span class="spt-mono">6740987b89d5e1ddc603f4f0</span>@T(") ou digite o nome.", ") or type its name.")</MudText>
                    </div>
                </div>
                <MudAutocomplete T="CatalogItem"
                                 @ref="search"
                                 Value="@selected"
                                 ValueChanged="@OnItemPicked"
                                 SearchFunc="@SearchItems"
                                 ToStringFunc="@(i => i is null ? string.Empty : i.Name)"
                                 Placeholder="@T("Buscar por nome ou ID...", "Search by name or ID...")"
                                 Variant="Variant.Outlined"
                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                 DebounceInterval="250"
                                 MinCharacters="2"
                                 MaxItems="40"
                                 ResetValueOnEmptyText="true"
                                 PopoverClass="clp-popover"
                                 Class="clp-search">
                    <ItemTemplate Context="item">
                        <div class="clp-option">
                            <img class="clp-option-img" src="@item.IconUrl" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                            <div class="clp-option-copy">
                                <span class="clp-option-name">@item.Name @if (!string.IsNullOrEmpty(item.ShortName)) { <em>(@item.ShortName)</em> }</span>
                                <span class="clp-option-meta">@item.ParentName · <span class="spt-mono">@item.Id</span></span>
                            </div>
                            @if (working.Entries.Any(e => e.Tpl.Equals(item.Id, StringComparison.OrdinalIgnoreCase)))
                            {
                                <span class="clp-tag">@T("já na lista", "already added")</span>
                            }
                        </div>
                    </ItemTemplate>
                    <NoItemsTemplate>
                        <MudText Class="pa-3 spt-muted">@T("Nenhum item encontrado.", "No items found.")</MudText>
                    </NoItemsTemplate>
                </MudAutocomplete>
            </MudPaper>

            <MudPaper Elevation="0" Class="clp-presets spt-panel pa-5">
                <div class="clp-section-head">
                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Class="clp-accent-icon" />
                    <div>
                        <MudText Typo="Typo.h6">@T("Presets e compartilhar", "Presets and sharing")</MudText>
                        <MudText Typo="Typo.body2" Class="spt-muted">@T("Adicione um conjunto pronto ou troque configurações com amigos.", "Add a ready-made set or swap settings with friends.")</MudText>
                    </div>
                </div>
                <div class="clp-preset-list">
                    @foreach (var preset in Presets)
                    {
                        <button type="button" class="clp-preset" @onclick="() => ApplyPreset(preset)">
                            <span class="clp-preset-icons">
                                @foreach (var tpl in preset.Entries.Select(x => x.Tpl))
                                {
                                    <img src="@Catalog.Get(tpl)?.IconUrl" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                                }
                            </span>
                            <span class="clp-preset-copy">
                                <strong>@T(preset.NamePt, preset.NameEn)</strong>
                                <span>@T(preset.DescPt, preset.DescEn)</span>
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                        </button>
                    }
                </div>
                <div class="clp-share-actions">
                    <button type="button" class="clp-btn" disabled="@(working.Entries.Count == 0)" @onclick="() => OpenShare(export: true)">
                        <MudIcon Icon="@Icons.Material.Filled.Upload" Size="Size.Small" /> @T("Exportar", "Export")
                    </button>
                    <button type="button" class="clp-btn" @onclick="() => OpenShare(export: false)">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" /> @T("Importar", "Import")
                    </button>
                </div>

                @if (shareMode == "export")
                {
                    <div class="clp-share">
                        <textarea class="clp-code" readonly rows="8">@exportJson</textarea>
                        <div class="clp-share-actions">
                            <button type="button" class="clp-btn clp-btn-primary" @onclick="CopyExport">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" /> @T("Copiar", "Copy")
                            </button>
                            <a class="clp-btn" download="customlootpool.json" href="@($"data:application/json;charset=utf-8,{Uri.EscapeDataString(exportJson)}")">
                                <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" /> @T("Baixar .json", "Download .json")
                            </a>
                            <button type="button" class="clp-btn clp-btn-ghost" @onclick="() => shareMode = null">@T("Fechar", "Close")</button>
                        </div>
                        <span class="clp-help">@T($"{working.Entries.Count} item(ns), com a configuração desta tela.", $"{working.Entries.Count} item(s), with the settings on this page.")</span>
                    </div>
                }
                else if (shareMode == "import")
                {
                    <div class="clp-share">
                        <textarea class="clp-code" rows="8" placeholder="@T("Cole aqui o JSON exportado...", "Paste the exported JSON here...")" @bind="importJson" @bind:event="oninput"></textarea>
                        <div class="clp-share-actions">
                            <label class="clp-btn">
                                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" /> @T("Abrir arquivo", "Open file")
                                <InputFile accept=".json,application/json" OnChange="LoadImportFile" class="clp-hidden-input" />
                            </label>
                            <button type="button" class="clp-btn clp-btn-primary" disabled="@string.IsNullOrWhiteSpace(importJson)" @onclick="() => Import(replace: false)">
                                @T("Adicionar à lista", "Add to my list")
                            </button>
                            <button type="button" class="clp-btn clp-btn-danger" disabled="@string.IsNullOrWhiteSpace(importJson)" @onclick="() => Import(replace: true)">
                                @T("Substituir a lista", "Replace my list")
                            </button>
                            <button type="button" class="clp-btn clp-btn-ghost" @onclick="() => shareMode = null">@T("Fechar", "Close")</button>
                        </div>
                        <span class="clp-help">@T("Itens que já estão na lista são pulados ao adicionar. Nada é salvo até você clicar em Salvar.", "Items already in your list are skipped when adding. Nothing is saved until you click Save.")</span>
                    </div>
                }
            </MudPaper>
        </div>

        @if (working.Entries.Count == 0)
        {
            <MudPaper Elevation="0" Class="spt-panel pa-6 clp-empty">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" />
                <MudText>@T("Nenhum item configurado ainda. Use a busca acima ou um preset para começar.", "No items configured yet. Use the search or a preset above to get started.")</MudText>
            </MudPaper>
        }
        else
        {
            var visible = VisibleEntries.ToList();
            <div class="clp-toolbar">
                <div class="clp-filter">
                    <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                    <input type="search" placeholder="@T("Filtrar itens...", "Filter items...")" @bind="filter" @bind:event="oninput" />
                </div>
                <span class="clp-toolbar-count">
                    @T($"{visible.Count} de {working.Entries.Count} itens · {working.Entries.Count(x => x.Enabled)} ligados", $"{visible.Count} of {working.Entries.Count} items · {working.Entries.Count(x => x.Enabled)} on")
                </span>
                <MudSpacer />
                <div class="clp-seg clp-seg-actions">
                    <button type="button" @onclick="() => SetEnabled(visible, true)"><MudIcon Icon="@Icons.Material.Filled.ToggleOn" Size="Size.Small" /> @T("Ligar todos", "Enable all")</button>
                    <button type="button" @onclick="() => SetEnabled(visible, false)"><MudIcon Icon="@Icons.Material.Filled.ToggleOff" Size="Size.Small" /> @T("Desligar todos", "Disable all")</button>
                </div>
                <div class="clp-seg clp-seg-actions">
                    <button type="button" @onclick="() => SetCollapsed(visible, true)"><MudIcon Icon="@Icons.Material.Filled.UnfoldLess" Size="Size.Small" /> @T("Recolher", "Collapse")</button>
                    <button type="button" @onclick="() => SetCollapsed(visible, false)"><MudIcon Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" /> @T("Expandir", "Expand")</button>
                </div>
            </div>

            @if (visible.Count == 0)
            {
                <div class="clp-empty-filter spt-muted">@T("Nenhum item com esse nome.", "No item matches that name.")</div>
            }
        }

        <div class="clp-grid">
            @foreach (var entry in VisibleEntries)
            {
                var item = Catalog.Get(entry.Tpl);
                var e = entry;
                var isCollapsed = collapsed.Contains(e);
                var tab = tabs.GetValueOrDefault(e, "static");
                var active = LootInjectionService.IsActiveNow(e.Schedule);
                <MudPaper Elevation="0" Class="@($"clp-card spt-panel {(e.Enabled ? "" : "clp-card-off")} {(isCollapsed ? "clp-card-collapsed" : "")} {(swapping.Contains(e) ? "clp-card-swapping" : "")}")" @key="e">
                    <div class="clp-card-head">
                        <button type="button" class="clp-img-box" title="@(isCollapsed ? T("Expandir", "Expand") : T("Recolher", "Collapse"))" @onclick="() => ToggleCollapsed(e)">
                            @if (item is not null)
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
                                     onerror="this.onerror=null;this.src='https://assets.tarkov.dev/@(item.Id)-icon.webp'" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Large" />
                            }
                        </button>
                        <div class="clp-card-title">
                            @if (swapping.Contains(e))
                            {
                                <div class="clp-swap">
                                    <span class="clp-swap-hint">
                                        @(freshCopies.Contains(e)
                                            ? T("Cópia criada com todas as configurações. Escolha o item dela:", "Copy created with every setting. Pick its item:")
                                            : T("Trocar o item, mantendo todas as configurações:", "Change the item, keeping every setting:"))
                                    </span>
                                    <MudAutocomplete T="CatalogItem"
                                                     Value="@null"
                                                     ValueChanged="@(picked => SwapItem(e, picked))"
                                                     SearchFunc="@SearchItems"
                                                     ToStringFunc="@(i => i is null ? string.Empty : i.Name)"
                                                     Placeholder="@T("Buscar o novo item por nome ou ID...", "Search the new item by name or ID...")"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                                     DebounceInterval="200"
                                                     MinCharacters="2"
                                                     MaxItems="30"
                                                     AutoFocus="true"
                                                     PopoverClass="clp-popover"
                                                     Class="clp-swap-search">
                                        <ItemTemplate Context="option">
                                            <div class="clp-option">
                                                <img class="clp-option-img" src="@option.IconUrl" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                                                <div class="clp-option-copy">
                                                    <span class="clp-option-name">@option.Name @if (!string.IsNullOrEmpty(option.ShortName)) { <em>(@option.ShortName)</em> }</span>
                                                    <span class="clp-option-meta">@option.ParentName · <span class="spt-mono">@option.Id</span></span>
                                                </div>
                                                @if (option.Id.Equals(e.Tpl, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="clp-tag">@T("item atual", "current item")</span>
                                                }
                                                else if (working.Entries.Any(x => x.Tpl.Equals(option.Id, StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <span class="clp-tag">@T("já na lista", "already added")</span>
                                                }
                                            </div>
                                        </ItemTemplate>
                                        <NoItemsTemplate>
                                            <MudText Class="pa-3 spt-muted">@T("Nenhum item encontrado.", "No items found.")</MudText>
                                        </NoItemsTemplate>
                                    </MudAutocomplete>
                                    <div class="clp-swap-actions">
                                        <button type="button" class="clp-btn clp-btn-ghost" @onclick="() => StopSwap(e)">
                                            @(freshCopies.Contains(e)
                                                ? T($"Manter {item?.Name ?? e.Name}", $"Keep {item?.Name ?? e.Name}")
                                                : T("Cancelar", "Cancel"))
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="clp-item-name-btn" title="@T("Trocar o item, mantendo as configurações", "Change the item, keeping the settings")" @onclick="() => StartSwap(e)">
                                    <MudText Typo="Typo.h6" Class="clp-item-name">@(item?.Name ?? e.Name ?? T("Item desconhecido", "Unknown item"))</MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Class="clp-item-swap-icon" />
                                </button>
                            }
                            @if (item is not null)
                            {
                                <span class="clp-meta">@item.ParentName · @(item.Width)x@(item.Height)</span>
                            }
                            else
                            {
                                <span class="clp-warn">@T("ID não existe no banco de dados do servidor. Este item será ignorado.", "This ID does not exist in the server database. The item will be ignored.")</span>
                            }
                            @if (isCollapsed)
                            {
                                <div class="clp-summary">
                                    @foreach (var (icon, text, on) in Summary(e))
                                    {
                                        <span class="@($"clp-summary-chip {(on ? "" : "clp-summary-off")}")"><MudIcon Icon="@icon" Size="Size.Small" />@text</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <button class="clp-id" title="@T("Copiar ID", "Copy ID")" @onclick="() => CopyId(e.Tpl)">
                                    <span class="spt-mono">@e.Tpl</span>
                                    <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                                </button>
                            }
                        </div>
                        <div class="clp-card-tools">
                            <MudSwitch T="bool" Value="@e.Enabled" ValueChanged="@(v => e.Enabled = v)" Color="Color.Warning" />
                            <MudTooltip Text="@T("Trocar o item (mantém as configurações)", "Change item (keeps the settings)")">
                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" OnClick="() => StartSwap(e)" />
                            </MudTooltip>
                            <MudTooltip Text="@T("Duplicar com as mesmas configurações e escolher outro item", "Duplicate with the same settings and pick another item")">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="() => Duplicate(e)" />
                            </MudTooltip>
                            <MudTooltip Text="@T("Remover", "Remove")">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="() => Remove(e)" />
                            </MudTooltip>
                            <MudTooltip Text="@(isCollapsed ? T("Expandir", "Expand") : T("Recolher", "Collapse"))">
                                <MudIconButton Icon="@(isCollapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)" Size="Size.Small" OnClick="() => ToggleCollapsed(e)" />
                            </MudTooltip>
                        </div>
                    </div>

                    @if (!isCollapsed)
                    {
                        @if (item is not null && Injection.GetItemWarnings(e.Tpl) is { Count: > 0 } warnings)
                        {
                            <div class="clp-warnings">
                                @foreach (var w in warnings)
                                {
                                    <div class="@($"clp-warning {(w.Blocking ? "clp-warning-block" : "")}")">
                                        <MudIcon Icon="@(w.Blocking ? Icons.Material.Filled.Block : Icons.Material.Filled.WarningAmber)" Size="Size.Small" />
                                        <span>@(IsPt ? w.Pt : w.En)</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="clp-general">
                            <div class="clp-row">
                                <span class="clp-row-label"><MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" /> @T("Mapas", "Maps")</span>
                                <MapPicker Maps="@AllMaps" Value="@e.Maps" ValueChanged="@(v => e.Maps = v)" Pt="@IsPt" />
                            </div>
                            <div class="clp-row">
                                <span class="clp-row-label"><MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" /> @T("Quando", "When")</span>
                                <div class="clp-when">
                                    <Segmented TValue="ScheduleMode" Options="@ScheduleOptions" Value="@e.Schedule.Mode" ValueChanged="@(v => e.Schedule.Mode = v)" />
                                    @if (e.Schedule.Mode == ScheduleMode.Dates)
                                    {
                                        <span class="clp-dates">
                                            <input type="date" value="@ToDateInput(e.Schedule.From)" @onchange="ev => e.Schedule.From = FromDateInput(ev.Value?.ToString(), e.Schedule.From)" />
                                            <span>@T("até", "to")</span>
                                            <input type="date" value="@ToDateInput(e.Schedule.To)" @onchange="ev => e.Schedule.To = FromDateInput(ev.Value?.ToString(), e.Schedule.To)" />
                                        </span>
                                    }
                                    @if (e.Schedule.Mode == ScheduleMode.Dates)
                                    {
                                        <span class="clp-help">@T("Repete todo ano, o ano da data é ignorado.", "Repeats every year, the year in the date is ignored.")</span>
                                    }
                                    @if (e.Schedule.Mode != ScheduleMode.Always)
                                    {
                                        <span class="@($"clp-status {(active ? "clp-status-on" : "")}")">
                                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" />
                                            @(active ? T("Ativo agora", "Active now") : T("Pausado agora", "Paused right now"))
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="clp-row">
                                <span class="clp-row-label"><MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" /> @T("Garantia", "Guarantee")</span>
                                <div class="clp-guarantee">
                                    <MudSwitch T="bool" Value="@e.Guaranteed" ValueChanged="@(v => e.Guaranteed = v)" Color="Color.Warning" Size="Size.Small"
                                               Label="@T("Pelo menos 1 por raid", "At least 1 per raid")" />
                                    <span class="clp-help">@T("Coloca 1 cópia extra em um ponto de loot solto aleatório a cada raid (os mesmos pontos do Loot solto).", "Places 1 extra copy at a random loose loot spot every raid (the same spots as Loose loot).")</span>
                                </div>
                            </div>
                        </div>

                        <div class="clp-tabs" role="tablist">
                            @foreach (var (key, icon, label, on, chance) in SourceTabs(e))
                            {
                                <button type="button" role="tab" aria-selected="@(tab == key)" class="@($"clp-tab {(tab == key ? "clp-tab-on" : "")}")" @onclick="() => tabs[e] = key">
                                    <MudIcon Icon="@icon" Size="Size.Small" />
                                    <span>@label</span>
                                    <span class="@($"clp-tab-state {(on ? "clp-tab-state-on" : "")}")">@(on ? chance : T("off", "off"))</span>
                                </button>
                            }
                        </div>

                        @switch (tab)
                        {
                            case "static":
                                <section class="@($"clp-block {(e.Static.Enabled ? "" : "clp-block-off")}")">
                                    <div class="clp-block-head">
                                        <span>@T("Itens sorteados dentro de contêineres (caixas, bolsas, gavetas...)", "Items rolled inside containers (crates, bags, drawers...)")</span>
                                        <MudSpacer />
                                        <MudSwitch T="bool" Value="@e.Static.Enabled" ValueChanged="@(v => e.Static.Enabled = v)" Color="Color.Warning" Size="Size.Small" />
                                    </div>
                                    <div class="clp-block-body">
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Onde", "Where")</span>
                                            <Segmented TValue="TargetMode" Options="@ModeOptions(loose: false)" Value="@e.Static.Mode" ValueChanged="@(v => SetStaticMode(e, item, v))" Disabled="@(!e.Static.Enabled)" Class="clp-seg-wrap" />
                                            @if (e.Static.Mode == TargetMode.Categories)
                                            {
                                                <CategoryPicker ItemTpl="@e.Tpl" Value="@e.Static.Categories" ValueChanged="@(v => e.Static.Categories = v)" Disabled="@(!e.Static.Enabled)" Pt="@IsPt" />
                                            }
                                            @if (e.Static.Mode == TargetMode.Selected)
                                            {
                                                <ChipPicker Options="@ContainerOptions" Value="@e.Static.Containers" ValueChanged="@(v => e.Static.Containers = v)" Disabled="@(!e.Static.Enabled)" Pt="@IsPt"
                                                            Label="@T("Contêineres escolhidos", "Chosen containers")"
                                                            Placeholder="@T("Buscar contêiner...", "Search containers...")"
                                                            EmptyText="@T("Nenhum ainda. Busque abaixo.", "None yet. Search below.")"
                                                            CountLabel="@T("mapas", "maps")" />
                                            }
                                            @if (e.Static.Enabled && e.Static.Mode is TargetMode.Similar or TargetMode.Categories)
                                            {
                                                <SimilarPoolInfo Pool="@Injection.GetSimilarPool(e, loose: false)" Loose="false" Pt="@IsPt" />
                                            }
                                        </div>
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Chance", "Chance")</span>
                                            <ChanceInput Value="@e.Static.ChancePercent" ValueChanged="@(v => e.Static.ChancePercent = v)" Disabled="@(!e.Static.Enabled)" Note="@ChanceNote(e, loose: false)" Pt="@IsPt"
                                                         Rarities="@Rarities(e, loose: false)" Maps="@EntryMaps(e)" MapChances="@e.Static.MapChances"
                                                         Help="@T("Chance de cada item sorteado dentro do contêiner ser este.", "Chance that each item rolled inside the container is this one.")" />
                                        </div>
                                    </div>
                                </section>
                                break;
                            case "loose":
                                <section class="@($"clp-block {(e.Loose.Enabled ? "" : "clp-block-off")}")">
                                    <div class="clp-block-head">
                                        <span>@T("Itens soltos no chão e em prateleiras", "Items lying on the floor and on shelves")</span>
                                        <MudSpacer />
                                        <MudSwitch T="bool" Value="@e.Loose.Enabled" ValueChanged="@(v => e.Loose.Enabled = v)" Color="Color.Warning" Size="Size.Small" />
                                    </div>
                                    <div class="clp-block-body">
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Onde", "Where")</span>
                                            <Segmented TValue="TargetMode" Options="@ModeOptions(loose: true)" Value="@e.Loose.Mode" ValueChanged="@(v => SetLooseMode(e, item, v))" Disabled="@(!e.Loose.Enabled)" Class="clp-seg-wrap" />
                                            @if (e.Loose.Mode == TargetMode.Categories)
                                            {
                                                <CategoryPicker ItemTpl="@e.Tpl" Value="@e.Loose.Categories" ValueChanged="@(v => e.Loose.Categories = v)" Disabled="@(!e.Loose.Enabled)" Pt="@IsPt" />
                                            }
                                            @if (e.Loose.Enabled && e.Loose.Mode is TargetMode.Similar or TargetMode.Categories)
                                            {
                                                <SimilarPoolInfo Pool="@Injection.GetSimilarPool(e, loose: true)" Loose="true" Pt="@IsPt" />
                                            }
                                        </div>
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Chance", "Chance")</span>
                                            <ChanceInput Value="@e.Loose.ChancePercent" ValueChanged="@(v => e.Loose.ChancePercent = v)" Disabled="@(!e.Loose.Enabled)" Note="@ChanceNote(e, loose: true)" Pt="@IsPt"
                                                         Rarities="@Rarities(e, loose: true)" Maps="@EntryMaps(e)" MapChances="@e.Loose.MapChances"
                                                         Help="@T("Quando um desses pontos spawna, chance de ser este item.", "When one of these spots spawns, chance it is this item.")" />
                                        </div>
                                    </div>
                                </section>
                                break;
                            case "bots":
                                <section class="@($"clp-block {(e.Bots.Enabled ? "" : "clp-block-off")}")">
                                    <div class="clp-block-head">
                                        <span>@T("Itens no inventário dos bots que você mata", "Items in the inventory of bots you kill")</span>
                                        <MudSpacer />
                                        <MudSwitch T="bool" Value="@e.Bots.Enabled" ValueChanged="@(v => e.Bots.Enabled = v)" Color="Color.Warning" Size="Size.Small" />
                                    </div>
                                    <div class="clp-block-body">
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Quem", "Who")</span>
                                            <div class="clp-maps">
                                                <button type="button" class="@($"clp-map {(e.Bots.Scavs ? "clp-map-on" : "")}")" disabled="@(!e.Bots.Enabled)" @onclick="() => e.Bots.Scavs = !e.Bots.Scavs">@Check(e.Bots.Scavs) Scavs</button>
                                                <button type="button" class="@($"clp-map {(e.Bots.Pmcs ? "clp-map-on" : "")}")" disabled="@(!e.Bots.Enabled)" @onclick="() => e.Bots.Pmcs = !e.Bots.Pmcs">@Check(e.Bots.Pmcs) PMCs</button>
                                                <button type="button" class="@($"clp-map {(e.Bots.Bosses ? "clp-map-on" : "")}")" disabled="@(!e.Bots.Enabled)" @onclick="() => e.Bots.Bosses = !e.Bots.Bosses">@Check(e.Bots.Bosses) @T("Bosses e guardas", "Bosses and guards")</button>
                                            </div>
                                            <span class="clp-field-label">@T("Onde no inventário", "Where in the inventory")</span>
                                            <div class="clp-maps">
                                                <button type="button" class="@($"clp-map {(e.Bots.Backpack ? "clp-map-on" : "")}")" disabled="@(!e.Bots.Enabled)" @onclick="() => e.Bots.Backpack = !e.Bots.Backpack">@Check(e.Bots.Backpack) @T("Mochila", "Backpack")</button>
                                                <button type="button" class="@($"clp-map {(e.Bots.Pockets ? "clp-map-on" : "")}")" disabled="@(!e.Bots.Enabled)" @onclick="() => e.Bots.Pockets = !e.Bots.Pockets">@Check(e.Bots.Pockets) @T("Bolsos", "Pockets")</button>
                                                <button type="button" class="@($"clp-map {(e.Bots.Vest ? "clp-map-on" : "")}")" disabled="@(!e.Bots.Enabled)" @onclick="() => e.Bots.Vest = !e.Bots.Vest">@Check(e.Bots.Vest) @T("Colete", "Vest")</button>
                                            </div>
                                            <span class="clp-help">@T("Usa o filtro de mapas e o \"Quando\" deste item.", "Uses this item's map filter and \"When\" setting.")</span>
                                        </div>
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Chance", "Chance")</span>
                                            <ChanceInput Value="@e.Bots.ChancePercent" ValueChanged="@(v => e.Bots.ChancePercent = v)" Disabled="@(!e.Bots.Enabled)" Pt="@IsPt"
                                                         Help="@T("Chance de cada item sorteado nesses lugares ser este. Um bot costuma ter de 2 a 10 itens nesses lugares.", "Chance that each item rolled into those places is this one. A bot usually gets 2 to 10 items there.")" />
                                        </div>
                                    </div>
                                </section>
                                break;
                            case "airdrops":
                                <section class="@($"clp-block {(e.Airdrops.Enabled ? "" : "clp-block-off")}")">
                                    <div class="clp-block-head">
                                        <span>@T("Caixas de airdrop", "Airdrop crates")</span>
                                        <MudSpacer />
                                        <MudSwitch T="bool" Value="@e.Airdrops.Enabled" ValueChanged="@(v => e.Airdrops.Enabled = v)" Color="Color.Warning" Size="Size.Small" />
                                    </div>
                                    <div class="clp-block-body">
                                        <div class="clp-block-col">
                                            <span class="clp-help">@T("Quando um airdrop cai, o item pode vir dentro da caixa, junto com o loot normal dela. Selecione os tipos de caixa permitidos.",
                                                                    "When an airdrop lands, the item can come inside the crate, on top of its normal loot. Select the allowed crate types.")</span>
                                            <MudSelect T="string" Label="@T("Tipos de airdrop", "Airdrop types")" MultiSelection="true"
                                                       SelectedValues="@e.Airdrops.Types" SelectedValuesChanged="@(values => e.Airdrops.Types = values.ToList())"
                                                       Disabled="@(!e.Airdrops.Enabled)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                @foreach (var type in AirdropTypes.All)
                                                {
                                                    <MudSelectItem T="string" Value="@type">@AirdropTypeName(type)</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <span class="clp-help">@T("Nenhuma seleção = todos os tipos. Não altera a frequência nem o tipo dos airdrops.", "No selection = all types. Does not change airdrop frequency or which type is generated.")</span>
                                        </div>
                                        <div class="clp-block-col">
                                            <span class="clp-field-label">@T("Chance por airdrop", "Chance per airdrop")</span>
                                            <ChanceInput Value="@e.Airdrops.ChancePercent" ValueChanged="@(v => e.Airdrops.ChancePercent = v)" Disabled="@(!e.Airdrops.Enabled)" Pt="@IsPt" Max="100"
                                                         Help="@T("100% = toda caixa dos tipos permitidos traz 1 deste item.", "100% = every allowed airdrop crate brings 1 of this item.")" />
                                        </div>
                                    </div>
                                </section>
                                break;
                        }

                        <div class="clp-reach">
                            <div class="clp-reach-buttons">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Map" Disabled="@(item is null)" OnClick="() => OpenHeatmap(e)">Loot Atlas</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.TravelExplore"
                                           Disabled="@(item is null || busy.ContainsKey(e))" OnClick="() => LoadPreview(e)">
                                    @T("Ver onde vai aparecer", "Show where it spawns")
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Casino"
                                           Disabled="@(item is null || busy.ContainsKey(e) || (!e.Static.Enabled && !e.Loose.Enabled && !e.Guaranteed))" OnClick="() => RunSimulation(e)">
                                    @T("Simular raids", "Simulate raids")
                                </MudButton>
                                <label>@T("Amostra", "Sample")
                                    <select value="@simulationRaids" @onchange="ChangeSample"><option value="4">4 raids</option><option value="25">25 raids</option><option value="100">100 raids</option></select>
                                </label>
                                @if (busy.TryGetValue(e, out var status))
                                {
                                    <span class="clp-busy"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Warning" /> @status</span>
                                }
                            </div>

                            @if (sims.TryGetValue(e, out var simResult))
                            {
                                var okResults = simResult.Where(x => x.Error is null).ToList();
                                var totalAvg = okResults.Count == 0 ? 0 : okResults.Average(r => r.StaticPerRaid + r.LoosePerRaid);
                                <div class="clp-sim">
                                    <div class="clp-sim-head">
                                        <strong>@T("Média por raid", "Average per raid")</strong>
                                        <span>@T($"({simResult.FirstOrDefault()?.Raids ?? 0} raids simulados por mapa, com a configuração atual desta tela, mesmo sem salvar)", $"({simResult.FirstOrDefault()?.Raids ?? 0} simulated raids per map, using the settings on this page, even if unsaved)")</span>
                                    </div>
                                    <div class="clp-sim-grid">
                                        @foreach (var r in simResult.Where(x => x.Error is not null))
                                        {
                                            <div class="clp-sim-row clp-sim-error">
                                                <span class="clp-sim-map">@r.MapName</span>
                                                <span class="clp-sim-errtext" title="@r.Error">
                                                    @T("Não foi possível simular este mapa. Consulte o erro para identificar a causa; a simulação não altera sua configuração salva.",
                                                       "Could not simulate this map. Check the error for its cause; simulation does not change your saved configuration.")
                                                </span>
                                            </div>
                                        }
                                        @foreach (var r in simResult.Where(x => x.Error is null))
                                        {
                                            var total = r.StaticPerRaid + r.LoosePerRaid;
                                            <div class="clp-sim-row">
                                                <span class="clp-sim-map">@r.MapName</span>
                                                <div class="clp-sim-bar"><div style="width:@(BarWidth(total, simResult))%"></div></div>
                                                <span class="clp-sim-num">@total.ToString("0.0#")</span>
                                                <span class="clp-sim-split">@r.StaticPerRaid.ToString("0.0#") @T("contêiner", "container") · @r.LoosePerRaid.ToString("0.0#") @T("chão", "loose")</span>
                                            </div>
                                        }
                                    </div>
                                    <span class="clp-help">
                                        @T($"Média geral: {totalAvg:0.0#} por raid. Amostra aleatória: zero ocorrências não significa que o item não possa aparecer.", $"Overall average: {totalAvg:0.0#} per raid. Random sample: zero occurrences do not mean the item cannot spawn.")
                                        @if (e.Bots.Enabled || e.Airdrops.Enabled)
                                        {
                                            @T(" Bots e airdrops não entram na simulação.", " Bots and airdrops are not part of the simulation.")
                                        }
                                    </span>
                                </div>
                            }

                            @if (previews.TryGetValue(e, out var reach))
                            {
                                <div class="clp-reach-list">
                                    @foreach (var r in reach)
                                    {
                                        var empty = r.ContainerTypes == 0 && r.Spawnpoints == 0;
                                        <MudTooltip Text="@(r.ContainerNames.Count == 0 ? T("Nenhum contêiner", "No containers") : string.Join(", ", r.ContainerNames))">
                                            <div class="@($"clp-reach-chip {(empty ? "clp-reach-empty" : "")}")">
                                                <strong>@r.MapName</strong>
                                                <span>@r.ContainerTypes @T("tipos de contêiner", "container types") · @r.Spawnpoints @T("pontos de loot solto", "loose-loot spots")</span>
                                            </div>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </div>

        <MudText Typo="Typo.caption" Class="spt-muted clp-footnote">
            @T("Imagens dos itens: assets.tarkov.dev. \"Itens parecidos\" = mesma categoria do item.",
               "Item images: assets.tarkov.dev. \"Similar items\" = same category as the item.")
        </MudText>
    </MudContainer>
</div>

@if (heatEntry is not null && heatContext is not null)
{
    <LootHeatmap Entry="@heatEntry" Context="@heatContext" OnClose="() => heatEntry = null" />
}

@code {
    private LootEntry? heatEntry;
    private LootPoolConfig? heatContext;
    private void OpenHeatmap(LootEntry entry)
    {
        heatContext = ConfigService.CloneConfigOf(working);
        heatEntry = heatContext.Entries[working.Entries.IndexOf(entry)];
    }
    private string AirdropTypeName(string type) => type switch
    {
        "mixed" => T("Suprimentos mistos", "Mixed supplies"),
        "weaponArmor" => T("Armas e armaduras", "Weapons and armor"),
        "foodMedical" => T("Comida e medicamentos", "Food and medical"),
        "barter" => T("Suprimentos de troca", "Barter supplies"),
        "radar" => T("Técnico / evento", "Technical / event"),
        _ => type,
    };
    private sealed record Preset(string NamePt, string NameEn, string DescPt, string DescEn, List<LootEntry> Entries);

    private static readonly List<Preset> Presets =
    [
        new("Evento dos Smugglers", "Smugglers event",
            "Locked case e Case key em contêineres e no chão, como no evento.",
            "Locked case and Case key in containers and on the floor, like the event.",
            [SmugglersEntry("6740987b89d5e1ddc603f4f0", "Locked case"), SmugglersEntry("67449b6c89d5e1ddc603f504", "Case key")]),
    ];

    private static LootEntry SmugglersEntry(string tpl, string name) => new()
    {
        Tpl = tpl,
        Name = name,
        Static = new StaticLootSettings { Enabled = true, Mode = TargetMode.Similar, ChancePercent = 0.25 },
        Loose = new LooseLootSettings { Enabled = true, Mode = TargetMode.Similar, ChancePercent = 0.5 },
    };

    private const string CollapsedKey = "clp-collapsed";

    private LootPoolConfig working = new();
    private string savedJson = string.Empty;
    private CatalogItem? selected;
    private MudAutocomplete<CatalogItem>? search;
    private readonly Dictionary<LootEntry, List<MapReach>> previews = [];
    private readonly Dictionary<LootEntry, string> busy = [];
    private readonly Dictionary<LootEntry, List<SimResult>> sims = [];
    private readonly Dictionary<LootEntry, string> tabs = [];
    private readonly HashSet<LootEntry> collapsed = [];
    private int simulationRaids = 4;
    private int savedRevision;
    private bool externalChange;
    private string? indexError;
    private readonly CancellationTokenSource lifetime = new();
    private List<PickOption> ContainerOptions = [];
    private string filter = string.Empty;
    private string? shareMode;
    private string exportJson = string.Empty;
    private string importJson = string.Empty;

    private bool IsDirty => Serialize(working) != savedJson;

    private List<string> AllMaps => Injection.Maps.Keys.OrderBy(MapName).ToList();

    private IEnumerable<LootEntry> VisibleEntries => string.IsNullOrWhiteSpace(filter)
        ? working.Entries
        : working.Entries.Where(e =>
            (Catalog.Get(e.Tpl)?.Name ?? e.Name ?? string.Empty).Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase)
            || (Catalog.Get(e.Tpl)?.ShortName ?? string.Empty).Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase)
            || e.Tpl.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        Catalog.EnsureFresh();
        Reload();
        ConfigService.ConfigChanged += OnExternalChange;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreCollapsed();
            await LoadPoolIndex();
        }
    }

    public void Dispose()
    {
        ConfigService.ConfigChanged -= OnExternalChange;
        lifetime.Cancel();
        lifetime.Dispose();
    }

    private void OnExternalChange() => InvokeAsync(() =>
    {
        if (!IsDirty) Reload();
        else externalChange = ConfigService.Revision != savedRevision;
        StateHasChanged();
    });

    private async Task LoadPoolIndex()
    {
        try
        {
            ContainerOptions = (await Injection.AllContainers()).Select(c => new PickOption(c.Id, c.Name)).ToList();
            indexError = null;
        }
        catch (Exception ex) { indexError = ex.Message; }
        StateHasChanged();
    }

    private void ChangeSample(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int count) && count is 4 or 25 or 100) simulationRaids = count;
        sims.Clear();
    }

    private void Reload()
    {
        var snapshot = ConfigService.GetSnapshot();
        working = snapshot.Config;
        savedRevision = snapshot.Revision;
        externalChange = false;
        savedJson = Serialize(working);
        previews.Clear();
        sims.Clear();
        tabs.Clear();
        collapsed.Clear();
        swapping.Clear();
        freshCopies.Clear();
    }

    // Language is saved on its own, so it never counts as an unsaved change
    private static string Serialize(LootPoolConfig cfg)
    {
        return System.Text.Json.JsonSerializer.Serialize(new { cfg.Enabled, cfg.Debug, cfg.CompensateLootMultipliers, cfg.Entries });
    }

    private bool IsPt => ConfigService.IsPortuguese;

    private bool showMultipliers;

    private static bool LotsOfLoot => LootInjectionService.LotsOfLootInstalled;

    private List<SegmentOption<ScheduleMode>> ScheduleOptions =>
    [
        new(ScheduleMode.Always, T("Sempre", "Always")),
        new(ScheduleMode.Dates, T("Entre datas", "Between dates")),
        new(ScheduleMode.Weekends, T("Fins de semana", "Weekends")),
    ];

    private List<SegmentOption<TargetMode>> ModeOptions(bool loose) => loose
        ?
        [
            new(TargetMode.Similar, T("Itens parecidos", "Similar items")),
            new(TargetMode.Categories, T("Escolher lootpools", "Pick loot pools")),
            new(TargetMode.All, T("Todos os pontos", "All spots")),
        ]
        :
        [
            new(TargetMode.Similar, T("Itens parecidos", "Similar items")),
            new(TargetMode.Categories, T("Escolher lootpools", "Pick loot pools")),
            new(TargetMode.All, T("Todos", "All")),
            new(TargetMode.Selected, T("Escolher contêineres", "Pick containers")),
        ];

    private RenderFragment Check(bool on) => on
        ? @<MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
        : @<span></span>;

    private static string Pct(double v) => (v < 1 ? v.ToString("0.###") : v.ToString("0.#")) + "%";

    private string ChanceText(double main, Dictionary<string, double> perMap, IEnumerable<string> maps)
    {
        var values = maps.Select(m => perMap.TryGetValue(m, out var v) ? v : main).ToList();
        return values.Count == 0 ? Pct(main) : PercentRange(values);
    }

    private IEnumerable<(string Key, string Icon, string Label, bool On, string Chance)> SourceTabs(LootEntry e)
    {
        var maps = EntryMaps(e);
        yield return ("static", Icons.Material.Filled.Inventory, T("Contêineres", "Containers"), e.Static.Enabled, ChanceText(e.Static.ChancePercent, e.Static.MapChances, maps));
        yield return ("loose", Icons.Material.Filled.Place, T("Chão", "Loose loot"), e.Loose.Enabled, ChanceText(e.Loose.ChancePercent, e.Loose.MapChances, maps));
        yield return ("bots", Icons.Material.Filled.SmartToy, T("Bots", "Bots"), e.Bots.Enabled, Pct(e.Bots.ChancePercent));
        yield return ("airdrops", Icons.Material.Filled.FlightLand, T("Airdrops", "Airdrops"), e.Airdrops.Enabled, Pct(e.Airdrops.ChancePercent));
    }

    private IEnumerable<(string Icon, string Text, bool On)> Summary(LootEntry e)
    {
        foreach (var (_, icon, label, on, chance) in SourceTabs(e).Where(t => t.On))
        {
            yield return (icon, $"{label} {chance}", true);
        }

        if (e.Guaranteed)
        {
            yield return (Icons.Material.Filled.Verified, T("1 garantido por raid", "1 guaranteed per raid"), true);
        }

        yield return (Icons.Material.Filled.Map, e.Maps.Count == 0 ? T("Todos os mapas", "All maps") : e.Maps.Count <= 2 ? string.Join(", ", e.Maps.Select(MapName)) : T($"{e.Maps.Count} mapas", $"{e.Maps.Count} maps"), true);

        if (e.Schedule.Mode != ScheduleMode.Always)
        {
            var active = LootInjectionService.IsActiveNow(e.Schedule);
            var when = e.Schedule.Mode == ScheduleMode.Weekends ? T("Fins de semana", "Weekends") : $"{ShortDate(e.Schedule.From)} {T("a", "to")} {ShortDate(e.Schedule.To)}";
            yield return (Icons.Material.Filled.Event, $"{when} · {(active ? T("ativo", "active") : T("pausado", "paused"))}", active);
        }
    }

    private List<string> EntryMaps(LootEntry e) => e.Maps.Count == 0 ? AllMaps : AllMaps.Where(m => e.Maps.Contains(m, StringComparer.OrdinalIgnoreCase)).ToList();

    private List<RarityOption>? Rarities(LootEntry e, bool loose)
    {
        var pool = Injection.GetSimilarPool(e, loose);
        var values = pool?.Items.Select(i => i.AveragePercent).Where(v => v > 0).OrderBy(v => v).ToList();
        if (values is null || values.Count < 3)
        {
            return null;
        }

        double At(double q) => Round(values[(int)Math.Round(q * (values.Count - 1))]);
        string where = pool!.CategoryName;
        return
        [
            new("common", T("Comum", "Common"), At(0.75), T($"Como os itens mais comuns de {where}", $"Like the most common items in {where}")),
            new("uncommon", T("Normal", "Typical"), At(0.5), T($"Como um item típico de {where}", $"Like a typical item in {where}")),
            new("rare", T("Raro", "Rare"), At(0.25), T($"Como os itens raros de {where}", $"Like the rare items in {where}")),
            new("legendary", T("Lendário", "Legendary"), At(0.1), T($"Como os itens mais raros de {where}", $"Like the rarest items in {where}")),
        ];
    }

    private static double Round(double v) => Math.Clamp(v < 0.1 ? Math.Round(v, 3) : v < 1 ? Math.Round(v, 2) : Math.Round(v, 1), 0.001, 90);

    private string? ChanceNote(LootEntry entry, bool loose)
    {
        var settingsEnabled = loose ? entry.Loose.Enabled : entry.Static.Enabled;
        if (!settingsEnabled || Injection.GetMultipliers() is not { } all || !all.Any(m => m.Changed))
        {
            return null;
        }

        var ratios = all
            .Where(m => entry.Maps.Count == 0 || entry.Maps.Contains(m.MapId, StringComparer.OrdinalIgnoreCase))
            .Select(m => loose ? m.Loose : m.Static)
            .Where(r => r > 0)
            .ToList();
        if (ratios.Count == 0)
        {
            return null;
        }

        double chance = loose ? entry.Loose.ChancePercent : entry.Static.ChancePercent;

        if (working.CompensateLootMultipliers)
        {
            var applied = PercentRange(ratios.Select(r => Math.Min(chance / r, 90)));
            return T($"Para compensar {ModLabel}, o mod usa {applied} por sorteio, conforme o mapa.",
                     $"To make up for {ModLabel}, the mod uses {applied} per roll, depending on the map.");
        }

        return T($"Com {ModLabel}, você acha {MultRange(ratios)} a quantidade que essa % daria no jogo original.",
                 $"With {ModLabel}, you'll find {MultRange(ratios)} as many as this % gives in vanilla.");
    }

    private string ModLabel => LotsOfLoot ? "Lots of Loot" : T("os multiplicadores atuais", "the current multipliers");

    private void SetCompensate(bool value)
    {
        working.CompensateLootMultipliers = value;
        sims.Clear();
    }

    private string MultRange(IEnumerable<double> values)
    {
        var list = values.Where(v => v > 0).ToList();
        if (list.Count == 0)
        {
            return "×1";
        }

        string Fmt(double v) => "×" + v.ToString(v < 10 ? "0.#" : "0");
        double min = list.Min(), max = list.Max();
        return Fmt(min) == Fmt(max) ? Fmt(min) : $"{Fmt(min)} {T("a", "to")} {Fmt(max)}";
    }

    private string PercentRange(IEnumerable<double> values)
    {
        var list = values.ToList();
        double min = list.Min(), max = list.Max();
        return Pct(min) == Pct(max) ? Pct(min) : $"{Pct(min)} {T("a", "to")} {Pct(max)}";
    }

    private string T(string pt, string en) => IsPt ? pt : en;

    private string MapName(string id) => ItemCatalogService.MapName(id, IsPt);

    private static string ToDateInput(string monthDay)
    {
        var parts = monthDay.Split('-');
        return parts.Length == 2 && int.TryParse(parts[0], out int m) && int.TryParse(parts[1], out int d)
            ? $"{DateTime.Now.Year:0000}-{m:00}-{d:00}"
            : string.Empty;
    }

    private static string FromDateInput(string? value, string fallback)
    {
        return DateTime.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date)
            ? $"{date.Month:00}-{date.Day:00}"
            : fallback;
    }

    private string ShortDate(string monthDay)
    {
        var parts = monthDay.Split('-');
        return parts.Length == 2 ? (IsPt ? $"{parts[1]}/{parts[0]}" : $"{parts[0]}/{parts[1]}") : monthDay;
    }

