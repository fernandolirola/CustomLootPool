    private async Task LoadImportFile(InputFileChangeEventArgs args)
    {
        try
        {
            using var reader = new StreamReader(args.File.OpenReadStream(2_000_000));
            importJson = await reader.ReadToEndAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(T("Não deu para ler o arquivo: ", "Could not read the file: ") + ex.Message, Severity.Error);
        }
    }

    private void Import(bool replace)
    {
        List<LootEntry> entries;
        try
        {
            entries = ConfigService.ImportEntries(importJson);
        }
        catch (Exception ex)
        {
            Snackbar.Add(T("JSON inválido: ", "Invalid JSON: ") + ex.Message, Severity.Error);
            return;
        }

        var valid = entries;
        int unknown = valid.Count(e => !Catalog.Exists(e.Tpl));
        if (replace)
        {
            working.Entries = valid;
            previews.Clear();
            sims.Clear();
            collapsed.Clear();
        }
        else
        {
            valid = valid.Where(e => !working.Entries.Any(x => x.Tpl.Equals(e.Tpl, StringComparison.OrdinalIgnoreCase))).ToList();
            working.Entries.InsertRange(0, valid);
        }

        importJson = string.Empty;
        shareMode = null;
        var msg = T($"{valid.Count} item(ns) importado(s). Não esqueça de salvar.", $"{valid.Count} item(s) imported. Don't forget to save.");
        if (unknown > 0)
        {
            msg += T($" {unknown} não existe(m) neste servidor e será(ão) ignorado(s).", $" {unknown} don't exist on this server and will be ignored.");
        }

        Snackbar.Add(msg, valid.Count > 0 ? Severity.Success : Severity.Info);
    }

    // Cards in "change item" mode, and copies that were just made and still wait for their item
    private readonly HashSet<LootEntry> swapping = [];
    private readonly HashSet<LootEntry> freshCopies = [];

    private void Duplicate(LootEntry entry)
    {
        var copy = ConfigService.Clone(entry);
        working.Entries.Insert(working.Entries.IndexOf(entry) + 1, copy);
        tabs[copy] = tabs.GetValueOrDefault(entry, "static");
        collapsed.Remove(copy);
        // The copy opens straight on the item picker; "Keep" leaves it as the same item (another % on other maps)
        freshCopies.Add(copy);
        swapping.Add(copy);
    }

    private void StartSwap(LootEntry entry)
    {
        collapsed.Remove(entry);
        swapping.Add(entry);
    }

    private void StopSwap(LootEntry entry)
    {
        swapping.Remove(entry);
        if (freshCopies.Remove(entry))
        {
            Snackbar.Add(T("Cópia mantida com o mesmo item. Útil para outra % em outros mapas ou datas.", "Copy kept with the same item. Handy for another % on other maps or dates."), Severity.Normal);
        }
    }

    private void SwapItem(LootEntry entry, CatalogItem? picked)
    {
        if (picked is null)
        {
            return;
        }

        swapping.Remove(entry);
        bool wasCopy = freshCopies.Remove(entry);
        if (picked.Id.Equals(entry.Tpl, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var old = (Tpl: entry.Tpl, Name: entry.Name, Static: entry.Static.Categories.ToList(), Loose: entry.Loose.Categories.ToList());
        var oldItem = Catalog.Get(entry.Tpl);

        entry.Tpl = picked.Id;
        entry.Name = picked.Name;
        // Loot pools that were only the old item's own category follow the new item; hand-picked pools stay
        if (oldItem is not null)
        {
            FollowCategory(entry.Static.Categories, oldItem.ParentId, picked.ParentId);
            FollowCategory(entry.Loose.Categories, oldItem.ParentId, picked.ParentId);
        }

        previews.Remove(entry);
        sims.Remove(entry);

        string from = oldItem?.Name ?? old.Name ?? old.Tpl;
        string message = wasCopy
            ? T($"Cópia agora é {picked.Name}, com as configurações de {from}.", $"The copy is now {picked.Name}, with the settings of {from}.")
            : T($"{from} trocado por {picked.Name}. As configurações foram mantidas.", $"{from} changed to {picked.Name}. Settings were kept.");
        if (working.Entries.Count(x => x.Tpl.Equals(picked.Id, StringComparison.OrdinalIgnoreCase)) > 1)
        {
            message += T(" Esse item já tinha um card; o mod usa a maior chance entre os dois.", " That item already had a card; the mod uses the higher chance of the two.");
        }

        Snackbar.Add(message, Severity.Success, options =>
        {
            options.Action = T("Desfazer", "Undo");
            options.ActionColor = Color.Warning;
            options.OnClick = _ =>
            {
                entry.Tpl = old.Tpl;
                entry.Name = old.Name;
                entry.Static.Categories = old.Static;
                entry.Loose.Categories = old.Loose;
                previews.Remove(entry);
                sims.Remove(entry);
                return InvokeAsync(StateHasChanged);
            };
        });
    }

    private static void FollowCategory(List<string> categories, string oldParent, string newParent)
    {
        if (categories.Count == 1 && categories[0].Equals(oldParent, StringComparison.OrdinalIgnoreCase))
        {
            categories[0] = newParent;
        }
    }

    private void SetEnabled(List<LootEntry> entries, bool enabled)
    {
        foreach (var e in entries)
        {
            e.Enabled = enabled;
        }
    }

    private async Task ToggleCollapsed(LootEntry entry)
    {
        if (!collapsed.Remove(entry))
        {
            collapsed.Add(entry);
        }

        await SaveCollapsed();
    }

    private async Task SetCollapsed(List<LootEntry> entries, bool value)
    {
        foreach (var e in entries)
        {
            if (value)
            {
                collapsed.Add(e);
            }
            else
            {
                collapsed.Remove(e);
            }
        }

        await SaveCollapsed();
    }

    // Collapsed cards are a per-browser preference, remembered by item ID
    private async Task SaveCollapsed()
    {
        try
        {
            var ids = collapsed.Select(e => e.Tpl).Distinct().ToArray();
            await JS.InvokeVoidAsync("localStorage.setItem", CollapsedKey, string.Join(",", ids));
        }
        catch
        {
        }
    }

    private async Task RestoreCollapsed()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", CollapsedKey);
            var ids = (raw ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var e in working.Entries.Where(e => ids.Contains(e.Tpl)))
            {
                collapsed.Add(e);
            }
        }
        catch
        {
        }
    }

    private void Remove(LootEntry entry)
    {
        working.Entries.Remove(entry);
        swapping.Remove(entry);
        freshCopies.Remove(entry);
        previews.Remove(entry);
        sims.Remove(entry);
        tabs.Remove(entry);
        collapsed.Remove(entry);
    }

    private async Task Discard()
    {
        Reload();
        await RestoreCollapsed();
        Snackbar.Add(T("Alterações descartadas.", "Changes discarded."), Severity.Normal);
    }

    private void Save()
    {
        try
        {
            foreach (var entry in working.Entries)
            {
                entry.Name = Catalog.Get(entry.Tpl)?.Name ?? entry.Name;
            }

            savedRevision = ConfigService.Save(working, savedRevision);
            externalChange = false;
            savedJson = Serialize(working);
            Snackbar.Add(T("Salvo! Vale a partir do próximo raid.", "Saved! Applies from the next raid."), Severity.Success);
        }
        catch (ConfigConflictException ex)
        {
            externalChange = true;
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(T("Erro ao salvar: ", "Failed to save: ") + ex.Message, Severity.Error);
        }
    }

    private async Task LoadPreview(LootEntry entry)
    {
        busy[entry] = T("Analisando mapas...", "Checking maps...");
        StateHasChanged();
        try
        {
            previews[entry] = await Injection.Preview(entry);
        }
        catch (Exception ex)
        {
            Snackbar.Add(T("Não foi possível calcular: ", "Could not calculate: ") + ex.Message, Severity.Error);
        }
        finally
        {
            busy.Remove(entry);
        }
    }

    private async Task RunSimulation(LootEntry entry)
    {
        busy[entry] = T("Preparando simulação...", "Preparing simulation...");
        StateHasChanged();
        try
        {
            sims[entry] = await Injection.Simulate(entry, simulationRaids, working.CompensateLootMultipliers, map =>
            {
                busy[entry] = T($"Simulando {map}...", $"Simulating {map}...");
                InvokeAsync(StateHasChanged);
            }, ct: lifetime.Token, context: working);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Snackbar.Add(T("Erro na simulação: ", "Simulation failed: ") + ex.Message, Severity.Error);
        }
        finally
        {
            busy.Remove(entry);
        }
    }

    private static double BarWidth(double value, List<SimResult> all)
    {
        var max = all.Where(r => r.Error is null).Select(r => r.StaticPerRaid + r.LoosePerRaid).DefaultIfEmpty(0).Max();
        return max <= 0 ? 0 : Math.Max(2, value / max * 100);
    }

