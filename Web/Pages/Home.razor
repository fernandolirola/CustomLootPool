    private async Task OnItemPicked(CatalogItem? item)
    {
        if (item is null)
        {
            return;
        }

        var existing = working.Entries.FirstOrDefault(e => e.Tpl.Equals(item.Id, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            collapsed.Remove(existing);
            Snackbar.Add(T($"{item.Name} já está na lista.", $"{item.Name} is already in the list."), Severity.Info);
        }
        else
        {
            working.Entries.Insert(0, new LootEntry { Tpl = item.Id, Name = item.Name });
            Snackbar.Add(T($"{item.Name} adicionado. Não esqueça de salvar.", $"{item.Name} added. Don't forget to save."), Severity.Success);
        }

        selected = null;
        if (search is not null)
        {
            await search.ClearAsync();
        }
    }

    private void ApplyPreset(Preset preset)
    {
        int added = 0;
        foreach (var entry in preset.Entries)
        {
            if (working.Entries.Any(e => e.Tpl.Equals(entry.Tpl, StringComparison.OrdinalIgnoreCase)) || !Catalog.Exists(entry.Tpl))
            {
                continue;
            }

            working.Entries.Insert(added++, ConfigService.Clone(entry));
        }

        Snackbar.Add(added == 0
            ? T("Esses itens já estão na lista.", "Those items are already in your list.")
            : T($"{added} item(ns) adicionado(s). Não esqueça de salvar.", $"{added} item(s) added. Don't forget to save."),
            added == 0 ? Severity.Info : Severity.Success);
    }

    private void OpenShare(bool export)
    {
        if (export)
        {
            exportJson = ConfigService.ExportEntries(working.Entries);
            shareMode = shareMode == "export" ? null : "export";
        }
        else
        {
            shareMode = shareMode == "import" ? null : "import";
        }
    }

